#include <stdio.h>
#include <stdbool.h>
#include <stdint.h>

#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_timer.h"

// =====================================
// CONFIGURACION GENERAL
// =====================================

#define MODO_SIMULACION true
#define BRAZO_CALIBRADO false

#define INTERVALO_CICLO_MS 20

// =====================================
// ESTADOS DEL SISTEMA
// =====================================

typedef enum {
    ESPERANDO_INICIALIZACION,
    ESPERANDO_CONTENEDOR,
    POSICIONANDO_CONTENEDOR,
    IDENTIFICANDO_COLOR,
    INICIANDO_RECOGIDA,
    APROXIMANDO_AL_RACK,
    ASENTANDO_SOBRE_PIEZA,
    INICIANDO_BAJADA_A_PIEZA,
    MOVIENDO_A_PIEZA,
    ASENTANDO_EN_PIEZA,
    SUJETANDO_PIEZA,
    INICIANDO_LEVANTAMIENTO,
    LEVANTANDO_PIEZA,
    ASENTANDO_TRAS_LEVANTAMIENTO,
    INICIANDO_TRASLADO,
    MOVIENDO_SOBRE_CONTENEDOR,
    ASENTANDO_SOBRE_CONTENEDOR,
    INICIANDO_DESCENSO,
    MOVIENDO_A_CONTENEDOR,
    ASENTANDO_EN_CONTENEDOR,
    SOLTANDO_PIEZA,
    INICIANDO_RETIRADA,
    RETIRANDO_BRAZO,
    ASENTANDO_TRAS_RETIRADA,
    INICIANDO_RETORNO,
    REGRESANDO_HOME,
    ASENTANDO_EN_HOME,
    LIBERANDO_CONTENEDOR,
    ESPERANDO_SALIDA,
    SISTEMA_EN_ERROR
} EstadoSistema;

// =====================================
// ESTRUCTURA DE POSICION
// =====================================

typedef struct {
    int base;
    int hombro;
    int codo;
    int muneca;
} PosicionBrazo;

// Posiciones exclusivamente de simulacion
static const PosicionBrazo SIM_HOME = {
    90, 90, 90, 90
};

// =====================================
// VARIABLES DEL SISTEMA
// =====================================

static EstadoSistema estadoSistema =
    ESPERANDO_INICIALIZACION;

static bool electroimanActivo = false;

static int64_t inicioEstado = 0;

// =====================================
// CONTROL DE ESTADOS
// =====================================

static void cambiarEstado(EstadoSistema nuevoEstado)
{
    estadoSistema = nuevoEstado;
    inicioEstado = esp_timer_get_time() / 1000;

    printf("Nuevo estado: %d\n", (int)estadoSistema);
}

// =====================================
// INICIALIZACION
// =====================================

static void inicializarSistema(void)
{
    printf("\n================================\n");
    printf(" SISTEMA DEL BRAZO ROBOTICO\n");
    printf("================================\n");

    electroimanActivo = false;

    if (MODO_SIMULACION) {
        printf("Modo simulacion activado\n");
        printf("Salidas fisicas deshabilitadas\n");
        printf("HOME simulado: %d %d %d %d\n",
               SIM_HOME.base,
               SIM_HOME.hombro,
               SIM_HOME.codo,
               SIM_HOME.muneca);
    }

    if (!BRAZO_CALIBRADO) {
        printf("AVISO: Brazo fisico sin calibrar\n");
    }

    cambiarEstado(ESPERANDO_INICIALIZACION);
}

// =====================================
// PROGRAMA PRINCIPAL
// =====================================

void app_main(void)
{
    inicializarSistema();

    printf("Inicializacion basica completada\n");
    printf("Ciclo automatico detenido\n");

    while (1) {

        // Los modulos de sensores, movimientos
        // y maquina de estados se incorporaran
        // y comprobaran progresivamente.

        vTaskDelay(
            pdMS_TO_TICKS(INTERVALO_CICLO_MS)
        );
    }
}

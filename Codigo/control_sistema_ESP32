void setup() {

  // Inicia la comunicación entre el ESP32 y la computadora
  Serial.begin(115200);

  Serial.println("Iniciando sistema...");

  // En simulación no inicializa pines ni dispositivos físicos.
  if (MODO_SIMULACION) {

        electroimanActivo = false;

    // Representa la disponibilidad del sensor ficticio.
    // No confirma la presencia de un sensor físico.
    sensorColorDisponible = sensorColorSimuladoDisponible;

    Serial.println(
      "SIMULACION: inicializacion fisica omitida."
    );

    // Registra únicamente una referencia ficticia.
    if (!registrarReferenciaInicial(Simulacion::HOME)) {

      registrarError(
        "No se pudo establecer la referencia simulada."
      );

      return;
    }

    Serial.println(
      "SIMULACION: referencia preparada; ciclo aun detenido."
    );

    // Termina setup(); luego se ejecutará loop().
    return;
  }

  // ================================
  // CONFIGURACIÓN DE PINES
  // ================================

    // Configura los pines únicamente en modo físico.
  if (!MODO_SIMULACION) {

    // Se supone una etapa de potencia activa en HIGH.
    digitalWrite(electroiman, LOW);
    pinMode(electroiman, OUTPUT);

    pinMode(sensorContenedor, INPUT);
  }

  // Estado interno inicial de la orden del electroimán.
  electroimanActivo = false;

  Serial.println("Pines configurados.");

  // ================================
  // CONFIGURACIÓN DEL PCA9685
  // ================================

  // Inicia la comunicación I2C
  Wire.begin(SDA_PIN, SCL_PIN);

  // ================================
  // CONFIGURACIÓN DEL TCS34725
  // ================================

  // Intenta iniciar el sensor de color mediante I2C
  sensorColorDisponible = tcs.begin();

  if (sensorColorDisponible) {

    Serial.println("TCS34725 configurado.");

  } else {

    registrarError("No se encontro el sensor de color TCS34725.");

  }


  // Inicia el controlador PCA9685
  pwm.begin();

  // Frecuencia típica para servomotores
  pwm.setPWMFreq(50);

  Serial.println("PCA9685 configurado.");
}

// ================================
// FUNCIÓN PARA MOVER UN SERVO
// ================================

void moverServo(int canal, int angulo) {

  // Verifica que el canal tenga una calibración definida.
  if (canal < 0 || canal >= CANTIDAD_SERVOS) {
    Serial.println("ERROR: Canal de servo no configurado.");
    return;
  }

  // Obtiene la calibración del servo seleccionado.
  const CalibracionServo& calibracion =
    calibracionServos[canal];

  // Limita el ángulo al rango permitido para ese servo.
  angulo = constrain(
    angulo,
    calibracion.anguloMin,
    calibracion.anguloMax
  );

  // Convierte el ángulo a cuentas del PCA9685.
  // pulsoMin y pulsoMax corresponden a 0° y 180°.
  int pulso = map(
    angulo,
    0,
    180,
    calibracion.pulsoMin,
    calibracion.pulsoMax
  );

  // Envía la señal al servo.
    if (MODO_SIMULACION) {

    // No envía señales al PCA9685.
    return;
  }

  pwm.setPWM(canal, 0, pulso);
}

// ================================
// AVANCE DE UN ÁNGULO HACIA SU DESTINO
// ================================

int acercarAngulo(int actual, int destino) {

  if (actual < destino) {
    return actual + 1;
  }

  if (actual > destino) {
    return actual - 1;
  }

  // Si ya llegó, mantiene el mismo ángulo.
  return actual;
}

// ================================
// CALCULAR EL SIGUIENTE PASO DEL BRAZO
// ================================

PosicionBrazo calcularPasoBrazo(
  PosicionBrazo actual,
  PosicionBrazo destino
) {

  PosicionBrazo siguiente;

  siguiente.base = acercarAngulo(
    actual.base, destino.base
  );

  siguiente.hombro = acercarAngulo(
    actual.hombro, destino.hombro
  );

  siguiente.codo = acercarAngulo(
    actual.codo, destino.codo
  );

  siguiente.muneca = acercarAngulo(
    actual.muneca, destino.muneca
  );

  return siguiente;
}

// ================================
// VALIDAR LA TABLA DE CALIBRACIÓN
// ================================

bool calibracionServosValida() {

  for (int canal = 0; canal < CANTIDAD_SERVOS; canal++) {

    const CalibracionServo& calibracion =
      calibracionServos[canal];

    bool angulosValidos =
      calibracion.anguloMin >= 0 &&
      calibracion.anguloMax <= 180 &&
      calibracion.anguloMin < calibracion.anguloMax;

    bool pulsosValidos =
      calibracion.pulsoMin > 0 &&
      calibracion.pulsoMax <= 4095 &&
      calibracion.pulsoMin < calibracion.pulsoMax;

    if (!angulosValidos || !pulsosValidos) {

      Serial.print("Calibracion invalida en canal: ");
      Serial.println(canal);

      return false;
    }
  }

  return true;
}

// ================================
// VALIDAR LOS ÁNGULOS DE UNA POSICIÓN
// ================================

bool posicionDentroDeLimites(PosicionBrazo posicion) {

  return
    posicion.base >= calibracionServos[SERVO_BASE].anguloMin &&
    posicion.base <= calibracionServos[SERVO_BASE].anguloMax &&

    posicion.hombro >= calibracionServos[SERVO_HOMBRO].anguloMin &&
    posicion.hombro <= calibracionServos[SERVO_HOMBRO].anguloMax &&

    posicion.codo >= calibracionServos[SERVO_CODO].anguloMin &&
    posicion.codo <= calibracionServos[SERVO_CODO].anguloMax &&

    posicion.muneca >= calibracionServos[SERVO_MUNECA].anguloMin &&
    posicion.muneca <= calibracionServos[SERVO_MUNECA].anguloMax;
}

// ================================
// VALIDAR LAS POSICIONES DEL CICLO
// ================================

bool posicionesDelCicloValidas() {

  // Primero comprueba la tabla.
  if (!calibracionServosValida()) {
    return false;
  }

  // En simulación comprueba las posiciones ficticias.
  if (MODO_SIMULACION) {

    return
      posicionDentroDeLimites(Simulacion::HOME) &&
      posicionDentroDeLimites(Simulacion::TORNILLO) &&
      posicionDentroDeLimites(Simulacion::TUERCA) &&
      posicionDentroDeLimites(Simulacion::ARANDELA) &&
      posicionDentroDeLimites(Simulacion::ELEVADA_TORNILLO) &&
      posicionDentroDeLimites(Simulacion::ELEVADA_TUERCA) &&
      posicionDentroDeLimites(Simulacion::ELEVADA_ARANDELA) &&
      posicionDentroDeLimites(Simulacion::SOBRE_CONTENEDOR) &&
      posicionDentroDeLimites(Simulacion::CONTENEDOR);
  }

  // En modo físico comprueba las posiciones reales.
  return
    posicionDentroDeLimites(HOME) &&
    posicionDentroDeLimites(POS_TORNILLO) &&
    posicionDentroDeLimites(POS_TUERCA) &&
    posicionDentroDeLimites(POS_ARANDELA) &&
    posicionDentroDeLimites(POS_ELEVADA_TORNILLO) &&
    posicionDentroDeLimites(POS_ELEVADA_TUERCA) &&
    posicionDentroDeLimites(POS_ELEVADA_ARANDELA) &&
    posicionDentroDeLimites(POS_SOBRE_CONTENEDOR) &&
    posicionDentroDeLimites(POS_CONTENEDOR);
}

// ================================
// REGISTRAR LA REFERENCIA INICIAL
// ================================

bool registrarReferenciaInicial(PosicionBrazo referencia) {

  // Verifica la tabla antes de validar la referencia.
  if (!calibracionServosValida()) {

    registrarError("La tabla de calibracion de servos es invalida.");
    return false;
  }

  if (!MODO_SIMULACION && !BRAZO_CALIBRADO) {
    Serial.println("ERROR: Falta completar la calibracion.");
    return false;
  }

  if (
    estadoSistema != ESPERANDO_INICIALIZACION ||
    movimientoEnCurso
  ) {
    Serial.println(
      "ERROR: No se puede registrar la referencia en este momento."
    );
    return false;
  }

  if (!posicionDentroDeLimites(referencia)) {
    Serial.println("ERROR: Referencia fuera de limites.");
    return false;
  }

  // Esta referencia debe haberse establecido
  // y confirmado previamente en el brazo físico.
  posicionActual = referencia;
  posicionDestino = referencia;
  posicionActualValida = true;

  Serial.println(
    "Referencia registrada. Ciclo automatico aun detenido."
  );

  return true;
}

// ================================
// SOLICITAR EL INICIO DEL CICLO
// ================================

bool iniciarCicloAutomatico() {

  // Rechaza el inicio si la tabla tiene valores incoherentes.
  if (!calibracionServosValida()) {

    registrarError("La tabla de calibracion de servos es invalida.");
    return false;
  }

  if (!sensorColorDisponible) {
    Serial.println("ERROR: El sensor de color no esta disponible.");
    return false;
  }

  if (!MODO_SIMULACION && !BRAZO_CALIBRADO) {
    Serial.println("ERROR: Falta completar la calibracion.");
    return false;
  }

  // Comprueba todas las posiciones utilizadas por el ciclo.
  if (!posicionesDelCicloValidas()) {

    registrarError(
      "Una o mas posiciones del ciclo estan fuera de limites."
    );

    return false;
  }

  if (
    estadoSistema != ESPERANDO_INICIALIZACION ||
    !posicionActualValida ||
    movimientoEnCurso
  ) {
    Serial.println(
      "ERROR: Falta una referencia inicial valida o el sistema no esta listo."
    );
    return false;
  }

  // Limpia los datos antes de habilitar el ciclo.
  piezaSeleccionadaValida = false;
  colorDetectado = DESCONOCIDO;
  intentosColor = 0;
  ultimaLecturaColor = 0;

  cambiarEstado(ESPERANDO_CONTENEDOR);

  Serial.println("Ciclo habilitado. Esperando contenedor.");
  return true;
}

// ================================
// INICIAR UN MOVIMIENTO PROGRESIVO
// ================================

bool iniciarMovimientoBrazo(PosicionBrazo destino) {

  // Comprueba la tabla antes de utilizar sus límites.
  if (!calibracionServosValida()) {

    registrarError("La tabla de calibracion de servos es invalida.");
    return false;
  }


  // Rechaza destinos fuera de los límites configurados.
  if (!posicionDentroDeLimites(destino)) {

    Serial.println(
      "Movimiento rechazado: destino fuera de limites."
    );

    return false;
  }

  // No usa los ceros iniciales como posición de partida.
  if (!posicionActualValida) {
    Serial.println(
      "ERROR: Falta establecer la posicion inicial del brazo."
    );
    return false;
  }

    // Comprueba la referencia numérica antes de usarla.
  if (!posicionDentroDeLimites(posicionActual)) {

    posicionActualValida = false;

    Serial.println(
      "Movimiento rechazado: referencia fuera de limites."
    );

    return false;
  }


  // Evita reemplazar un movimiento que todavía no terminó.
  if (movimientoEnCurso) {
    Serial.println("ERROR: El brazo ya tiene un movimiento en curso.");
    return false;
  }

  // Limita el destino según cada articulación.
  destino.base = constrain(
    destino.base,
    calibracionServos[SERVO_BASE].anguloMin,
    calibracionServos[SERVO_BASE].anguloMax
  );

  destino.hombro = constrain(
    destino.hombro,
    calibracionServos[SERVO_HOMBRO].anguloMin,
    calibracionServos[SERVO_HOMBRO].anguloMax
  );

  destino.codo = constrain(
    destino.codo,
    calibracionServos[SERVO_CODO].anguloMin,
    calibracionServos[SERVO_CODO].anguloMax
  );

  destino.muneca = constrain(
    destino.muneca,
    calibracionServos[SERVO_MUNECA].anguloMin,
    calibracionServos[SERVO_MUNECA].anguloMax
  );

  posicionDestino = destino;
  ultimoPasoMovimiento = millis();
  movimientoEnCurso = true;

  Serial.println("Movimiento progresivo preparado.");
  return true;
}

// ================================
// FUNCIÓN PARA MOVER EL BRAZO
// ================================

void moverBrazo(PosicionBrazo posicion) {

  // Ajusta cada ángulo a los límites configurados.
  posicion.base = constrain(
    posicion.base,
    calibracionServos[SERVO_BASE].anguloMin,
    calibracionServos[SERVO_BASE].anguloMax
  );

  posicion.hombro = constrain(
    posicion.hombro,
    calibracionServos[SERVO_HOMBRO].anguloMin,
    calibracionServos[SERVO_HOMBRO].anguloMax
  );

  posicion.codo = constrain(
    posicion.codo,
    calibracionServos[SERVO_CODO].anguloMin,
    calibracionServos[SERVO_CODO].anguloMax
  );

  posicion.muneca = constrain(
    posicion.muneca,
    calibracionServos[SERVO_MUNECA].anguloMin,
    calibracionServos[SERVO_MUNECA].anguloMax
  );

  // Envía las órdenes a los cuatro servos.
  moverServo(SERVO_BASE, posicion.base);
  moverServo(SERVO_HOMBRO, posicion.hombro);
  moverServo(SERVO_CODO, posicion.codo);
  moverServo(SERVO_MUNECA, posicion.muneca);

  // Guarda los ángulos que se acaban de ordenar.
  // Esto no confirma que el brazo haya llegado físicamente.
  posicionActual = posicion;
  posicionActualValida = true;
}

// ================================
// ACTUALIZAR EL MOVIMIENTO PROGRESIVO
// ================================

void actualizarMovimientoBrazo() {

  if (!movimientoEnCurso) {
    return;
  }

   if (!posicionActualValida) {
    registrarError("Posicion de partida no valida.");
    return;
  }

  unsigned long ahora = millis();

  if (ahora - ultimoPasoMovimiento < INTERVALO_PASO_MS) {
    return;
  }

  ultimoPasoMovimiento = ahora;

  PosicionBrazo siguiente = calcularPasoBrazo(
    posicionActual,
    posicionDestino
  );

  moverBrazo(siguiente);

  if (
    posicionActual.base == posicionDestino.base &&
    posicionActual.hombro == posicionDestino.hombro &&
    posicionActual.codo == posicionDestino.codo &&
    posicionActual.muneca == posicionDestino.muneca
  ) {
    movimientoEnCurso = false;

    Serial.println(
      "Destino ordenado. Llegada fisica no verificada."
    );
  }
}


// ================================
// CONTROL DEL ELECTROIMÁN
// ================================

void activarElectroiman() {

  if (!MODO_SIMULACION) {
    digitalWrite(electroiman, HIGH);
  }

  electroimanActivo = true;

  Serial.println("Electroiman ACTIVADO");
}


void desactivarElectroiman() {

  if (!MODO_SIMULACION) {
    digitalWrite(electroiman, LOW);
  }
  electroimanActivo = false;

  Serial.println("Electroiman DESACTIVADO");
}

// ================================
// DETECCIÓN DEL CONTENEDOR
// ================================

// Actualiza la presencia solo después de una lectura estable.
void actualizarFiltroContenedor() {

  unsigned long ahora = millis();

  // La detección se considera activa en LOW.
    bool lecturaActual;

  if (MODO_SIMULACION) {
    lecturaActual = contenedorSimulado;
  } else {
    // En modo físico, la detección es activa en LOW.
    lecturaActual = digitalRead(sensorContenedor) == LOW;
  }

  // La primera lectura inicia el tiempo de comprobación.
  if (!filtroContenedorInicializado) {

    lecturaContenedorAnterior = lecturaActual;
    ultimoCambioContenedor = ahora;
    inicioInestabilidadContenedor = ahora;
    presenciaContenedorValida = false;
    filtroContenedorInicializado = true;

    return;
  }

  // Si cambia la señal, reinicia la comprobación.
  if (lecturaActual != lecturaContenedorAnterior) {

    // Inicia un nuevo período de inestabilidad
    // solo si antes había una lectura válida.
    if (presenciaContenedorValida) {
      inicioInestabilidadContenedor = ahora;
    }

    lecturaContenedorAnterior = lecturaActual;
    ultimoCambioContenedor = ahora;
    presenciaContenedorValida = false;

    return;
  }

  // Acepta la lectura cuando se mantiene estable.
  if (
    !presenciaContenedorValida &&
    ahora - ultimoCambioContenedor >= FILTRO_CONTENEDOR_MS
  ) {

    presenciaContenedorEstable = lecturaActual;
    presenciaContenedorValida = true;
  }
}

bool detectarContenedor() {

  return presenciaContenedorValida &&
         presenciaContenedorEstable;
}

// ================================
// LECTURA DEL SENSOR DE COLOR
// ================================

// ================================
// IDENTIFICACIÓN DEL COLOR
// ================================

Color leerColor() {

  if (MODO_SIMULACION) {

    Serial.println("SIMULACION: lectura de color ficticia.");
    return colorSimulado;
  }

  // Variables donde se guardarán las mediciones
  // realizadas por el TCS34725
  uint16_t rojo;
  uint16_t verde;
  uint16_t azul;
  uint16_t claro;

  // Obtiene los valores de rojo, verde, azul y luz total
  tcs.getRawData(&rojo, &verde, &azul, &claro);

  // Muestra las mediciones en el monitor serie
  // para poder calibrar el sensor posteriormente
  Serial.print("Rojo: ");
  Serial.print(rojo);

  Serial.print(" | Verde: ");
  Serial.print(verde);

  Serial.print(" | Azul: ");
  Serial.print(azul);

  Serial.print(" | Claro: ");
  Serial.println(claro);

  // Por ahora no se clasifica el color,
  // ya que primero debemos calibrar el sensor.
  return DESCONOCIDO;
}

// ================================
// LECTURA DEL COLOR CON REINTENTOS
// ================================

Color leerColorConReintentos() {

  const int MAX_INTENTOS = 3;

  for (int intento = 1; intento <= MAX_INTENTOS; intento++) {

    Serial.print("Intento de lectura: ");
    Serial.println(intento);

    Color color = leerColor();

    // Si se reconoció un color válido, termina la función
    if (color != DESCONOCIDO) {

      Serial.println("Color identificado correctamente.");
      return color;
    }

    // Si no se reconoció, espera antes de volver a medir
    Serial.println("Color no identificado. Reintentando...");
    delay(200);
  }

  // Si fallaron todos los intentos
  Serial.println("No fue posible identificar el color.");
  return DESCONOCIDO;
}

// ================================
// SELECCIONAR LA PIEZA SEGÚN EL COLOR
// ================================

bool seleccionarPieza(Color color) {

   // Borra las selecciones del ciclo anterior.
  piezaSeleccionadaValida = false;

  posicionPiezaSeleccionada = {0, 0, 0, 0};
  posicionElevadaSeleccionada = {0, 0, 0, 0};

  switch (color) {

    case ROJO:
            if (MODO_SIMULACION) {

        posicionPiezaSeleccionada = Simulacion::TORNILLO;
        posicionElevadaSeleccionada =
          Simulacion::ELEVADA_TORNILLO;

      } else {

        posicionPiezaSeleccionada = POS_TORNILLO;
        posicionElevadaSeleccionada = POS_ELEVADA_TORNILLO;
      }
      Serial.println("Seleccion: TORNILLO");
      break;

    case VERDE:
        if (MODO_SIMULACION) {

        posicionPiezaSeleccionada = Simulacion::TUERCA;
        posicionElevadaSeleccionada =
          Simulacion::ELEVADA_TUERCA;

      } else {

        posicionPiezaSeleccionada = POS_TUERCA;
        posicionElevadaSeleccionada = POS_ELEVADA_TUERCA;
      }
      Serial.println("Seleccion: TUERCA");
      break;

    case AZUL:
        if (MODO_SIMULACION) {

        posicionPiezaSeleccionada = Simulacion::ARANDELA;
        posicionElevadaSeleccionada =
          Simulacion::ELEVADA_ARANDELA;

      } else {

        posicionPiezaSeleccionada = POS_ARANDELA;
        posicionElevadaSeleccionada = POS_ELEVADA_ARANDELA;
      }
      Serial.println("Seleccion: ARANDELA");
      break;

    default:
      Serial.println("No se pudo seleccionar una pieza.");
      return false;
  }

  // Confirma la selección de ambas posiciones por color.
  // No confirma calibración, stock ni pieza recogida.
  piezaSeleccionadaValida = true;
  return true;
}

// ================================
// TOMAR Y DEPOSITAR UNA PIEZA
// ================================

void tomarYDepositar(PosicionBrazo posicionPieza) {

  Serial.println("Moviendo brazo hacia la pieza...");

  // 1. Ir a la posición donde está la pieza
  moverBrazo(posicionPieza);
  delay(1000);

  // 2. Activar el electroimán para sujetarla
  activarElectroiman();
  delay(500);

  // 3. Llevar la pieza hasta el contenedor
  Serial.println("Moviendo pieza hacia el contenedor...");
  moverBrazo(POS_CONTENEDOR);
  delay(1000);

  // 4. Soltar la pieza
  desactivarElectroiman();
  delay(500);

  // 5. Regresar a la posición inicial
  Serial.println("Regresando a HOME...");
  moverBrazo(HOME);
  delay(1000);
}

// ================================
// CONTROL DEL TOPE
// ================================

void activarTope() {

  // Coloca el tope para mantener el contenedor en posición
  moverServo(SERVO_TOPE, TOPE_ACTIVO);

  Serial.println("Tope ACTIVADO");

  // Espera a que el servo complete el movimiento
  delay(500);
}


void retirarTope() {

  // Retira el tope para liberar el contenedor
  moverServo(SERVO_TOPE, TOPE_LIBRE);

  Serial.println("Tope RETIRADO");

  // Espera a que el servo complete el movimiento
  delay(500);
}

// ================================
// CAMBIAR EL ESTADO DEL SISTEMA
// ================================

void cambiarEstado(EstadoSistema nuevoEstado) {

  // Cancela el envío de nuevos pasos al entrar en error.
  if (nuevoEstado == SISTEMA_EN_ERROR) {

    movimientoEnCurso = false;

    // Conserva la última posición ordenada como destino.
    posicionDestino = posicionActual;

    // No apaga el electroimán:
    // podría estar sosteniendo una pieza.
    Serial.println(
      "ERROR: Movimiento progresivo cancelado."
    );
  }

  estadoSistema = nuevoEstado;

  // Guarda el momento de entrada al nuevo estado.
  inicioEstado = millis();
}

// ================================
// REGISTRAR UN ERROR DEL SISTEMA
// ================================

void registrarError(const char* mensaje) {

  // Conserva la causa original si ya estamos en error.
  if (estadoSistema == SISTEMA_EN_ERROR) {
    return;
  }

  // Usar textos fijos entre comillas al llamar esta función.
  ultimoError = mensaje;

  Serial.print("Causa del error: ");
  Serial.println(ultimoError);

  // Cancela los pasos pendientes y conserva
  // el estado del electroimán.
  cambiarEstado(SISTEMA_EN_ERROR);
}

// ================================
// COMPROBAR RESPUESTA EN EL BUS I2C
// ================================

bool dispositivoI2CResponde(uint8_t direccion) {

  if (MODO_SIMULACION) {

    // Por ahora solo simulamos la consulta al PCA9685.
    if (direccion == 0x40) {
      return pcaSimuladoDisponible;
    }

    return false;
  }

  Wire.beginTransmission(direccion);

  return Wire.endTransmission() == 0;
}

// ================================
// PREPARAR UNA NUEVA INICIALIZACIÓN
// ================================

bool prepararNuevaInicializacion() {

  // Solo permite esta operación desde el estado de error.
  if (estadoSistema != SISTEMA_EN_ERROR) {
    Serial.println("ERROR: El sistema no esta en estado de error.");
    return false;
  }

  // Podría haber una pieza sostenida.
  // No apaga el electroimán automáticamente.
  if (electroimanActivo) {

    Serial.println(
      "Recuperacion bloqueada: electroiman activado."
    );

    Serial.println(
      "Se requiere resolver la sujecion de la pieza antes de continuar."
    );

    return false;
  }

  // Exige una lectura estable antes de evaluar la estación.
  if (!presenciaContenedorValida) {

    Serial.println(
      "Recuperacion bloqueada: lectura de presencia sin estabilizar."
    );

    return false;
  }

  // No continúa si el sensor todavía detecta un contenedor.
  if (presenciaContenedorEstable) {

    Serial.println(
      "Recuperacion bloqueada: hay un contenedor en la estacion."
    );

    return false;
  }

    // Usa el sensor ficticio o el físico según el modo.
  if (MODO_SIMULACION) {
    sensorColorDisponible = sensorColorSimuladoDisponible;
  } else {
    sensorColorDisponible = tcs.begin();
  }

  if (!sensorColorDisponible) {

    Serial.println(
      "Recuperacion bloqueada: no se encuentra el sensor de color."
    );

    return false;
  }

  // Dirección correspondiente al PCA9685 configurado
  // con el constructor predeterminado de nuestro código.
  if (!dispositivoI2CResponde(0x40)) {

    Serial.println(
      "Recuperacion bloqueada: no responde el PCA9685 en 0x40."
    );

    return false;
  }

  // Cancela cualquier movimiento pendiente.
  movimientoEnCurso = false;

  // Exige establecer nuevamente la referencia física.
  posicionActualValida = false;

  // Limpia las selecciones del ciclo interrumpido.
  piezaSeleccionadaValida = false;
  colorDetectado = DESCONOCIDO;
  intentosColor = 0;
  ultimaLecturaColor = 0;

  // Conserva el error registrado para poder consultarlo.
  // No cambia el electroimán ni el tope.
  // No abandona todavía el estado de error.
  Serial.println(
    "Comprobaciones de preparacion superadas. Referencia invalidada; sistema aun en error."
  );

  return true;
}

// ================================
// COMPROBAR EL TIEMPO EN UN ESTADO
// ================================

bool tiempoEstadoCumplido(unsigned long duracionMs) {

  return millis() - inicioEstado >= duracionMs;
}

// ================================
// CONSULTAR EL ESTADO POR PUERTO SERIE
// ================================

void atenderComandosSerie() {

  if (Serial.available() <= 0) {
    return;
  }

  char comando = Serial.read();

  // Ignora los saltos de línea del Monitor Serie.
  if (comando == '\n' || comando == '\r') {
    return;
  }

  if (comando == '?') {

    Serial.println("--- ESTADO DEL SISTEMA ---");
    Serial.print("Ultimo error registrado: ");
    Serial.println(ultimoError);

    Serial.print("Sensor de color inicializado: ");
    Serial.println(sensorColorDisponible ? "SI" : "NO");

    Serial.print("Lectura de presencia valida: ");
    Serial.println(presenciaContenedorValida ? "SI" : "NO");

    Serial.print("Contenedor presente: ");

    if (presenciaContenedorValida) {
      Serial.println(presenciaContenedorEstable ? "SI" : "NO");
    } else {
      Serial.println("SIN LECTURA ESTABLE");
    }

    Serial.print("Brazo calibrado: ");
    Serial.println(BRAZO_CALIBRADO ? "SI" : "NO");

    Serial.print("Referencia registrada: ");
    Serial.println(posicionActualValida ? "SI" : "NO");

    Serial.print("Movimiento en curso: ");
    Serial.println(movimientoEnCurso ? "SI" : "NO");

    Serial.print("Estado del ciclo (numero): ");
    Serial.println((int)estadoSistema);

      } else if (comando == '1' || comando == '0') {

    if (!MODO_SIMULACION) {

      Serial.println(
        "Comando disponible solo en simulacion."
      );

    } else {

      contenedorSimulado = (comando == '1');

      Serial.println(
        contenedorSimulado
          ? "SIMULACION: contenedor presente."
          : "SIMULACION: contenedor ausente."
      );
    }

    } else if (
    comando == 't' ||
    comando == 'u' ||
    comando == 'a' ||
    comando == 'x'
  ) {

    if (!MODO_SIMULACION) {

      Serial.println(
        "Comando disponible solo en simulacion."
      );

    } else if (
      estadoSistema != ESPERANDO_INICIALIZACION &&
      estadoSistema != ESPERANDO_CONTENEDOR &&
      estadoSistema != SISTEMA_EN_ERROR
    ) {

      Serial.println(
        "No se permite cambiar el color durante el procesamiento."
      );

    } else {

      switch (comando) {

        case 't':
          colorSimulado = ROJO;
          Serial.println("SIMULACION: rojo, tornillo.");
          break;

        case 'u':
          colorSimulado = VERDE;
          Serial.println("SIMULACION: verde, tuerca.");
          break;

        case 'a':
          colorSimulado = AZUL;
          Serial.println("SIMULACION: azul, arandela.");
          break;

        case 'x':
          colorSimulado = DESCONOCIDO;
          Serial.println("SIMULACION: color desconocido.");
          break;
      }
    }

  } else if (comando == 'i' || comando == 'I') {

    iniciarCicloAutomatico();

    } else if (comando == 'p' || comando == 'P') {

      registrarError("Parada solicitada por puerto serie.");

  } else if (comando == 'r' || comando == 'R') {

    if (prepararNuevaInicializacion()) {

      cambiarEstado(ESPERANDO_INICIALIZACION);

      Serial.println(
        "Recuperacion preparada. Falta establecer una nueva referencia."
      );
    }

  } else {

        Serial.println(
      "Use ?: estado, i: inicio, p: parada, r: preparar reinicializacion."
    );

    if (MODO_SIMULACION) {

      Serial.println(
        "SIMULACION: 1: llega contenedor, 0: sale contenedor."
      );

      Serial.println(
        "Colores: t: tornillo, u: tuerca, a: arandela, x: desconocido."
      );
    }
  }
}

// ================================
// PROGRAMA PRINCIPAL
// ================================

void loop() {
   atenderComandosSerie();
   actualizarFiltroContenedor();

  // Bloquea el ciclo hasta completar la calibración.
  if (!MODO_SIMULACION && !BRAZO_CALIBRADO) {

    static bool avisoMostrado = false;

    if (!avisoMostrado) {
      Serial.println(
        "Ciclo bloqueado: falta calibrar el brazo."
      );
      avisoMostrado = true;
    }

    return;
  }

  // Detecta una señal que permanece sin estabilizarse.
  // Se supervisa durante el funcionamiento automático.
  if (
    estadoSistema != ESPERANDO_INICIALIZACION &&
    estadoSistema != SISTEMA_EN_ERROR &&
    filtroContenedorInicializado &&
    !presenciaContenedorValida &&
    millis() - inicioInestabilidadContenedor >=
      MAX_INESTABILIDAD_CONTENEDOR_MS
  ) {

    registrarError(
      "La señal del sensor de contenedor no se estabiliza."
    );
  }


  // Durante el procesamiento, el contenedor debe permanecer
  // en la zona de detección.
  bool requiereContenedor =
    estadoSistema != ESPERANDO_INICIALIZACION &&
    estadoSistema != ESPERANDO_CONTENEDOR &&
    estadoSistema != LIBERANDO_CONTENEDOR &&
    estadoSistema != ESPERANDO_SALIDA &&
    estadoSistema != SISTEMA_EN_ERROR;

  if (
    requiereContenedor &&
    presenciaContenedorValida &&
    !presenciaContenedorEstable
  ) {

    registrarError(
      "Se perdio la presencia del contenedor."
    );
  }

  // Atiende los pasos de un movimiento ya iniciado.
  actualizarMovimientoBrazo();

  switch (estadoSistema) {

      case ESPERANDO_INICIALIZACION:

      // Muestra el aviso una sola vez.
      static bool avisoInicializacionMostrado = false;

      if (!avisoInicializacionMostrado) {

        Serial.println(
          "Esperando establecer y confirmar la referencia inicial."
        );

        Serial.println(
          "El ciclo automatico permanece detenido."
        );

        avisoInicializacionMostrado = true;
      }
      break;

    case ESPERANDO_CONTENEDOR:

      if (detectarContenedor()) {

        // Limpia los datos del ciclo anterior.
        colorDetectado = DESCONOCIDO;
        piezaSeleccionadaValida = false;

        // Reinicia los intentos de color para este contenedor.
        intentosColor = 0;
        ultimaLecturaColor = 0;

        // Ordena colocar el tope sin detener el programa.
        moverServo(SERVO_TOPE, TOPE_ACTIVO);

        Serial.println("Posicionando contenedor...");

        cambiarEstado(POSICIONANDO_CONTENEDOR);
      }

      break;

    case POSICIONANDO_CONTENEDOR:

      // Tiempo provisional para el movimiento del tope.
      if (tiempoEstadoCumplido(500)) {
        cambiarEstado(IDENTIFICANDO_COLOR);
      }

      break;

    case IDENTIFICANDO_COLOR: {

      unsigned long ahora = millis();

      // La primera lectura se realiza inmediatamente.
      // Las siguientes esperan el intervalo indicado.
      if (
        intentosColor > 0 &&
        ahora - ultimaLecturaColor < INTERVALO_COLOR_MS
      ) {
        break;
      }

      intentosColor++;

      Serial.print("Intento de color: ");
      Serial.println(intentosColor);

      colorDetectado = leerColor();

      // Cuenta el intervalo desde que terminó la lectura.
      ultimaLecturaColor = millis();

      if (colorDetectado != DESCONOCIDO) {

        if (seleccionarPieza(colorDetectado)) {
          cambiarEstado(INICIANDO_RECOGIDA);
        } else {
          registrarError("No se pudo seleccionar la pieza.");
        }

      } else if (intentosColor >= MAX_INTENTOS_COLOR) {

      // El desvío y la recuperación siguen pendientes.
        registrarError(
          "Color desconocido tras tres intentos."
        );
      }

      break;
    }

        case INICIANDO_RECOGIDA:

      if (!piezaSeleccionadaValida) {

        registrarError("No hay una pieza seleccionada.");

      } else if (
        iniciarMovimientoBrazo(posicionElevadaSeleccionada)
      ) {

        cambiarEstado(APROXIMANDO_AL_RACK);

      } else {

        registrarError("No se pudo iniciar la aproximacion al rack.");
      }

      break;

    case APROXIMANDO_AL_RACK:

      if (!posicionActualValida) {

         registrarError("Referencia de posicion perdida.");

      } else if (!movimientoEnCurso) {

        cambiarEstado(ASENTANDO_SOBRE_PIEZA);
      }

      break;

    case ASENTANDO_SOBRE_PIEZA:

      // Espera provisional después del último paso ordenado.
      if (tiempoEstadoCumplido(500)) {
        cambiarEstado(INICIANDO_BAJADA_A_PIEZA);
      }

      break;

    case INICIANDO_BAJADA_A_PIEZA:

      if (iniciarMovimientoBrazo(posicionPiezaSeleccionada)) {

        cambiarEstado(MOVIENDO_A_PIEZA);

      } else {

        registrarError("No se pudo iniciar la bajada hacia la pieza.");
      }

      break;

        case MOVIENDO_A_PIEZA:

      // Espera hasta terminar de enviar los pasos.
      if (!posicionActualValida) {

         registrarError("Referencia de posicion perdida.");

      } else if (!movimientoEnCurso) {

        cambiarEstado(ASENTANDO_EN_PIEZA);
      }

      break;

    case ASENTANDO_EN_PIEZA:

      // Espera adicional desde el último paso ordenado.
      // Tiempo provisional: requiere pruebas físicas.
      if (tiempoEstadoCumplido(500)) {

        activarElectroiman();
        cambiarEstado(SUJETANDO_PIEZA);
      }

      break;

    case SUJETANDO_PIEZA:

      // Tiempo provisional para establecer la sujeción.
      // No confirma que se haya recogido una pieza.
      if (tiempoEstadoCumplido(500)) {

        Serial.println(
          "Espera de sujecion terminada."
        );

        cambiarEstado(INICIANDO_LEVANTAMIENTO);
      }

      break;

        case INICIANDO_LEVANTAMIENTO:

      if (!piezaSeleccionadaValida) {

        registrarError("Falta seleccionar la posicion de elevacion.");

      } else if (
        iniciarMovimientoBrazo(posicionElevadaSeleccionada)
      ) {

        cambiarEstado(LEVANTANDO_PIEZA);

      } else {

        registrarError("No se pudo iniciar la elevacion de la pieza.");
      }

      break;

    case LEVANTANDO_PIEZA:

      if (!posicionActualValida) {

        registrarError("Referencia de posicion perdida.");

      } else if (!movimientoEnCurso) {

        cambiarEstado(ASENTANDO_TRAS_LEVANTAMIENTO);
      }

      break;

    case ASENTANDO_TRAS_LEVANTAMIENTO:

      // Tiempo provisional después del último paso ordenado.
      if (tiempoEstadoCumplido(500)) {
        cambiarEstado(INICIANDO_TRASLADO);
      }

      break;

    case INICIANDO_TRASLADO:
  
        if (iniciarMovimientoBrazo(
        MODO_SIMULACION
          ? Simulacion::SOBRE_CONTENEDOR
          : POS_SOBRE_CONTENEDOR
      )) {

        cambiarEstado(MOVIENDO_SOBRE_CONTENEDOR);

      } else {

        registrarError("No se pudo iniciar el traslado sobre el contenedor.");
      }

      break;

    case MOVIENDO_SOBRE_CONTENEDOR:

      if (!posicionActualValida) {

        registrarError("Referencia de posicion perdida.");

      } else if (!movimientoEnCurso) {

        cambiarEstado(ASENTANDO_SOBRE_CONTENEDOR);
      }

      break;

    case ASENTANDO_SOBRE_CONTENEDOR:

      // Espera provisional después del último paso ordenado.
      if (tiempoEstadoCumplido(500)) {
        cambiarEstado(INICIANDO_DESCENSO);
      }

      break;

    case INICIANDO_DESCENSO:

        if (iniciarMovimientoBrazo(
        MODO_SIMULACION
          ? Simulacion::CONTENEDOR
          : POS_CONTENEDOR
      )) {

        cambiarEstado(MOVIENDO_A_CONTENEDOR);

      } else {

        registrarError("No se pudo iniciar el descenso al contenedor.");
      }

      break;

    case MOVIENDO_A_CONTENEDOR:

      if (!posicionActualValida) {

        registrarError("Referencia de posicion perdida.");

      } else if (!movimientoEnCurso) {

        cambiarEstado(ASENTANDO_EN_CONTENEDOR);
      }

      break;

    case ASENTANDO_EN_CONTENEDOR:

      // Espera provisional después del último paso ordenado.
      if (tiempoEstadoCumplido(500)) {

        desactivarElectroiman();
        cambiarEstado(SOLTANDO_PIEZA);
      }

      break;

    case SOLTANDO_PIEZA:

      // Tiempo provisional para permitir que la pieza caiga.
      // No confirma físicamente que se haya soltado.
      if (tiempoEstadoCumplido(500)) {
        cambiarEstado(INICIANDO_RETIRADA);
      }

      break;

    case INICIANDO_RETIRADA:

        if (iniciarMovimientoBrazo(
        MODO_SIMULACION
          ? Simulacion::SOBRE_CONTENEDOR
          : POS_SOBRE_CONTENEDOR
      )) {

        cambiarEstado(RETIRANDO_BRAZO);

      } else {

        registrarError("No se pudo iniciar la retirada del brazo.");
      }

      break;

    case RETIRANDO_BRAZO:

      if (!posicionActualValida) {

        registrarError("Referencia de posicion perdida.");

      } else if (!movimientoEnCurso) {

        cambiarEstado(ASENTANDO_TRAS_RETIRADA);
      }

      break;

    case ASENTANDO_TRAS_RETIRADA:

      // Espera provisional después del último paso ordenado.
      if (tiempoEstadoCumplido(500)) {
        cambiarEstado(INICIANDO_RETORNO);
      }

      break;

    case INICIANDO_RETORNO:

          if (iniciarMovimientoBrazo(
        MODO_SIMULACION
          ? Simulacion::HOME
          : HOME
      )) {

        cambiarEstado(REGRESANDO_HOME);

      } else {

        registrarError("No se pudo iniciar el retorno a HOME.");
      }

      break;

    case REGRESANDO_HOME:

      if (!posicionActualValida) {

         registrarError("Referencia de posicion perdida.");

      } else if (!movimientoEnCurso) {

        cambiarEstado(ASENTANDO_EN_HOME);
      }

      break;

    case ASENTANDO_EN_HOME:

      // Tiempo provisional para asentarse en HOME.
      if (tiempoEstadoCumplido(500)) {

        // Retira el tope sin llamar a la función con delay().
        moverServo(SERVO_TOPE, TOPE_LIBRE);

        Serial.println("Liberando contenedor...");
        cambiarEstado(LIBERANDO_CONTENEDOR);
      }

      break;

    case LIBERANDO_CONTENEDOR:

      // Tiempo provisional para retirar el tope.
      if (tiempoEstadoCumplido(500)) {
        cambiarEstado(ESPERANDO_SALIDA);
      }

      break;

    case ESPERANDO_SALIDA:

      if (
        presenciaContenedorValida &&
        !presenciaContenedorEstable
      ) {

        // Limpia las selecciones del ciclo terminado.
        piezaSeleccionadaValida = false;
        colorDetectado = DESCONOCIDO;

        Serial.println("Ciclo terminado.");
        Serial.println("Esperando siguiente contenedor...");

        cambiarEstado(ESPERANDO_CONTENEDOR);

      } else if (tiempoEstadoCumplido(10000)) {

        // Límite provisional de 10 segundos.
                registrarError(
          "El contenedor no abandono la estacion en el tiempo previsto."
        );
      }
      break;

    case SISTEMA_EN_ERROR:

      // La recuperación del error se implementará después.
      break;

    default:

        registrarError("Estado del ciclo inesperado o no implementado.");
      break;
  }
}    
